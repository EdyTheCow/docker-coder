#!/usr/bin/env bash
# `code` shim for Coder workspaces running code-server.
#
# T3 Code's "Open in editor" (and any `code <path>` / `code --goto file:line`)
# spawns the `code` command on the workspace host. There is no native `code`
# binary here, so this shim routes the call to the code-server instance already
# running in the browser, via its bundled remote CLI + IPC socket. The file or
# folder then opens in the code-server tab.
set -euo pipefail

log() { printf 'code: %s\n' "$*" >&2; }

# 1) Locate code-server's remote CLI. Prefer the one belonging to the code-server
#    on PATH (matches the running server); fall back to the Coder code-server
#    module's default install prefix (/tmp/code-server), newest install first.
remote_cli=""
if command -v code-server >/dev/null 2>&1; then
  base="$(dirname "$(dirname "$(readlink -f "$(command -v code-server)")")")"
  cand="$base/lib/vscode/bin/remote-cli/code-server"
  [ -x "$cand" ] && remote_cli="$cand"
fi
if [ -z "$remote_cli" ]; then
  cand="$(ls -dt /tmp/code-server/lib/code-server-*/lib/vscode/bin/remote-cli/code-server 2>/dev/null | head -1)"
  [ -n "$cand" ] && [ -x "$cand" ] && remote_cli="$cand"
fi
if [ -z "$remote_cli" ]; then
  log "code-server remote CLI not found; is code-server installed?"
  exit 127
fi

# 2) Find a live IPC socket (a running code-server window). If we were launched
#    from code-server's own terminal, VSCODE_IPC_HOOK_CLI is already set and points
#    at the right window — honour it. Otherwise (e.g. spawned by t3) discover one,
#    probing newest-first with the read-only --status to skip stale sockets.
probe() { timeout 5 env VSCODE_IPC_HOOK_CLI="$1" "$remote_cli" --status >/dev/null 2>&1; }
sock=""
if [ -n "${VSCODE_IPC_HOOK_CLI:-}" ] && probe "$VSCODE_IPC_HOOK_CLI"; then
  sock="$VSCODE_IPC_HOOK_CLI"
else
  # VS Code writes these under XDG_RUNTIME_DIR/TMPDIR when set, else /tmp. Search
  # all candidates newest-first; a live window answers --status, stale files don't.
  for s in $(ls -t \
      ${XDG_RUNTIME_DIR:+"$XDG_RUNTIME_DIR"/vscode-ipc-*.sock} \
      ${TMPDIR:+"$TMPDIR"/vscode-ipc-*.sock} \
      /tmp/vscode-ipc-*.sock 2>/dev/null | awk '!seen[$0]++'); do
    if probe "$s"; then
      sock="$s"
      break
    fi
  done
fi
if [ -z "$sock" ]; then
  log "no running code-server window found; open code-server in your browser first"
  exit 1
fi

# 3) Default to reusing the current code-server window instead of spawning yet
#    another browser tab — t3's "Open" passes a folder/--goto with no window mode,
#    and reusing the open tab is the friendlier behaviour. Skip the override when
#    the caller already chose a window mode or this is an informational command.
reuse=1
for arg in "$@"; do
  case "$arg" in
    -r|--reuse-window|-n|--new-window|-h|--help|--version|--status|-d|--diff|-m|--merge)
      reuse=0
      break
      ;;
  esac
done

# 4) Hand off to the real CLI bound to that window.
if [ "$reuse" -eq 1 ]; then
  exec env VSCODE_IPC_HOOK_CLI="$sock" "$remote_cli" --reuse-window "$@"
fi
exec env VSCODE_IPC_HOOK_CLI="$sock" "$remote_cli" "$@"
